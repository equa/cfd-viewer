# Rebuildable: pip install -r requirements.txt
.venv/
__pycache__/
*.pyc

# --- data/ ------------------------------------------------------------------
# data/ is a working directory: point --data at whatever you like, including
# symlinks to real cases elsewhere on the machine. None of that belongs in this
# repo, so everything here is ignored by default and the bundled demo cases are
# re-included explicitly: hotRoom (what the suites open) and cavity (a second,
# tiny case, so the start screen always has more than one to list).
data/*
!data/hotRoom/
!data/cavity/

# Of each demo case, version only the *definition*; its `Allrun` regenerates
# the rest (see CLAUDE.md "Demo data").
data/*/[0-9]*/
!data/*/0/
# hotRoom only: its 0/T is written by setFields from 0/T.orig. (The cavity's
# 0/T is a real input and is versioned.)
data/hotRoom/0/T
# Written by blockMesh and the solver.
data/*/constant/polyMesh/
data/*/log.*
data/*/run.log
data/*/*.foam
data/*/postProcessing/
data/*/processor*/

# Screenshot output from the browser suites
/shots/

# The client: both rebuild from web/package.json (npm install && npm run build).
# dist/ is deliberately NOT committed -- the container builds it in a node stage,
# and a stale committed bundle silently shadowing a source change is a bad day.
web/node_modules/
web/dist/

# doit's task state (dodo.py); .doit.db* from before it moved to JSON
.doit.json
.doit.db*
